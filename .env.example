# Canonical origin — used for metadata, JSON-LD, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Shopify
# Permanent myshopify domain
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=

# Admin GraphQL API
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Storefront API
SHOPIFY_STOREFRONT_API_TOKEN=

# Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Webhooks + internal admin routes (copied from reference for future use).
SHOPIFY_WEBHOOK_SECRET=
SESSION_SECRET=

# Internal merchant/diagnostic routes
ADMIN_API_KEY=

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_MP_API_SECRET=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# CJDropshipping API
CJ_API_EMAIL=
CJ_API_KEY=
# Vendor allowlist for the products/create|update webhook — must match the
# `vendor` field on your Shopify products, or product webhooks silently no-op.
SHOPIFY_ALLOWED_PRODUCT_BRANDS=
